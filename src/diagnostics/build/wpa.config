CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_IEEE80211W=y
CONFIG_EAP=y
CONFIG_EAP_PSK=y
CONFIG_EAP_MD5=y
CONFIG_EAP_TLS=y
CONFIG_DEBUG_FILE=y
